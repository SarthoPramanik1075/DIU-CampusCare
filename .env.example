# DIU CampusCare — environment template
# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# ADR-001: the two services hold SEPARATE credentials to SEPARATE databases.
# The core application role has no CONNECT privilege on the counseling database.
# That separation is the whole point; do not "simplify" it by sharing a URL.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# SRS §2.4 — all times are Bangladesh Standard Time. No multi-timezone support.
TZ=Asia/Dhaka

# ---------------------------------------------------------------------------
# Administrative connection — migrations and local database setup ONLY.
# Never used by a running service.
# ---------------------------------------------------------------------------
# Local installs commonly use trust auth on the unix socket and scram over
# TCP. The `?host=` form selects the socket directory. On a server, or in CI,
# this is an ordinary TCP URL with a password.
ADMIN_DATABASE_URL=postgresql://postgres@localhost/postgres?host=/tmp

# ---------------------------------------------------------------------------
# Core Application — deployable 1, credential set A
# ---------------------------------------------------------------------------
CORE_API_PORT=3001
CORE_DATABASE_URL=postgresql://campuscare_core_app:CHANGE_ME@localhost:5432/campuscare_core

# Session cookie — API §0.2 (HttpOnly, Secure, SameSite=Lax)
SESSION_COOKIE_NAME=ccc_session
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# Shared secret for service-to-service calls — API Part 12
INTERNAL_SERVICE_TOKEN=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# CORS: the one browser origin allowed to call this API in development.
WEB_APP_ORIGIN=http://localhost:5173

# SSO (FR-AUTH-01, API §1.1/§1.2) — OAuth2 Authorization Code + PKCE against
# DIU's identity provider. Optional: leave all four unset and the service
# runs normally, with GET /auth/sso/login returning 503 SSO_UNAVAILABLE so
# the client falls back to the email/password form (CON-05 — "SSO
# availability is not guaranteed"). Setting only some of the four is a
# startup error, not a supported partial state.
# SSO_ISSUER_URL=https://idp.diu.edu.bd
# SSO_CLIENT_ID=CHANGE_ME
# SSO_CLIENT_SECRET=CHANGE_ME
# SSO_REDIRECT_URI=http://localhost:3001/api/v1/auth/sso/callback

# ---------------------------------------------------------------------------
# Counseling Service — deployable 2, credential set B (ADR-001)
# ---------------------------------------------------------------------------
COUNSELING_API_PORT=3002
COUNSELING_DATABASE_URL=postgresql://campuscare_counseling_app:CHANGE_ME@localhost:5432/campuscare_counseling

# [R3] DIU-CP-01 crisis protocol content.
# BR-68 / EC-48: the counseling service REFUSES TO START if this is absent.
# That is a deployment gate, not a warning.
CRISIS_PROTOCOL_PATH=./apps/counseling-api/content/crisis-protocol

# Core IAM endpoint used to validate sessions — ARCHITECTURE §7.4
CORE_API_INTERNAL_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Feature flags — ARCHITECTURE §3.4. These are architectural, not cosmetic.
# ---------------------------------------------------------------------------
# When off, every /counseling/api/v1/* route returns 404 (not 403 — a 403
# would confirm the routes exist). This is the OI-01 deployment gate.
FEATURE_COUNSELING_ENABLED=false

# When off, in-app notifications continue and email dispatch is recorded as
# skipped. Care is never blocked by notification failure (NFR-REL-05).
FEATURE_EMAIL_ENABLED=false

# ---------------------------------------------------------------------------
# Web client
# ---------------------------------------------------------------------------
VITE_CORE_API_URL=http://localhost:3001
VITE_COUNSELING_API_URL=http://localhost:3002
